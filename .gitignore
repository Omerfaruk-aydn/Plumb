# API keys and secrets
.env
.env~

# plumb settings
# We want to keep the .plumb in the root of the repo and ignore any .plumb
# in subdirectories. In our root .plumb we want to allow for version control
# for subcommands.
**/.plumb/
!/.plumb/
.plumb/*
!.plumb/config.yaml
!.plumb/commands/
!.plumb/skills/
!.plumb/settings.json

# Note: .plumb-clipboard/ is NOT in gitignore so PLUMB can access pasted images

# Dependency directory
node_modules
bower_components

# Editors
.idea
*.iml

# OS metadata
.DS_Store
Thumbs.db

# TypeScript build info files
*.tsbuildinfo

# Ignore built ts files
dist

# Docker folder to help skip auth refreshes
.docker

bundle

# Test report files
junit.xml
packages/*/coverage/

# Generated files
packages/cli/src/generated/
packages/core/src/generated/
packages/devtools/src/_client-assets.ts
.integration-tests/
.perf-tests/
packages/vscode-ide-companion/*.vsix
packages/cli/download-ripgrep*/

# GHA credentials
gha-creds-*.json

# Log files
patch_output.log
plumb-debug.log

.genkit
.plumb-clipboard/
.eslintcache
evals/logs/

temp_agents/

# conductor extension and planning directories
conductor/

# Command Code working directory (scratchpad + state)
.commandcode/

# Windows sandbox helper binary (build artifact)
packages/core/src/sandbox/windows/PlumbSandbox.exe
